# One image: the React build served by the Hono server (Node). Deployed with Kamal.
#
#   stage 1  npm ci + vite build  -> dist/
#   stage 2  node:24-slim, production dependencies only, server/ + dist/
#
# VITE_* values are baked into the bundle at build time and are PUBLIC by design
# (the Supabase publishable key ships in every browser; row-level security protects
# the data). Server-side settings (VOIPAPPZ_API_URL, …) are runtime env, never baked.

FROM node:24-slim AS build
WORKDIR /build
ARG VITE_APP_VERSION
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ENV VITE_APP_VERSION=$VITE_APP_VERSION \
    VITE_SUPABASE_URL=$VITE_SUPABASE_URL \
    VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM node:24-slim
WORKDIR /app
ENV NODE_ENV=production PORT=3000 STATIC_DIR=/app/dist
# The server needs only Hono (the React packages are already compiled into dist/).
# Exactly the versions in package-lock.json (what the tests and the audit checked).
COPY package-lock.json /tmp/lock.json
RUN v() { node -p "require('/tmp/lock.json').packages['node_modules/$1'].version"; } \
 && npm init -y >/dev/null && npm pkg set type=module \
 && npm install --omit=dev --no-audit --no-fund "hono@$(v hono)" "@hono/node-server@$(v @hono/node-server)" \
 && rm /tmp/lock.json && npm cache clean --force
COPY server/index.js ./server/index.js
COPY --from=build /build/dist ./dist
ARG VITE_APP_VERSION
ENV APP_VERSION=$VITE_APP_VERSION
USER node
EXPOSE 3000
# kamal-proxy checks /health (config/deploy.yml).
CMD ["node", "server/index.js"]
