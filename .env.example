# Copy to .env for local development (never commit .env).

# --- server (Hono): runtime, never baked into the browser bundle ---
# The voipappz-api this app talks to; /api/* and /auth/* are passed to it.
VOIPAPPZ_API_URL=https://cloud.voipappz.io
PORT=3000

# --- browser (Vite): baked into the bundle at build time, PUBLIC by design ---
# Supabase sign-in. The publishable key ships in every browser; row-level security
# protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
